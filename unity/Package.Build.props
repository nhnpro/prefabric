<Project>
  <PropertyGroup>
    <_PrefabricImportBuildProps>false</_PrefabricImportBuildProps>
    <_PrefabricImportBuildProps Condition="'$(PrefabricBuildPropsImported)' == ''">true</_PrefabricImportBuildProps>
    <PrefabricBuildPropsImported>true</PrefabricBuildPropsImported>
    <PrefabricActive Condition="'$(PrefabricActive)' == ''">false</PrefabricActive>
  </PropertyGroup>

  <Import Project="$(SolutionDir)Library/Prefabric/MSBuild/Prefabric.Generated.props"
          Condition="'$(_PrefabricImportBuildProps)' == 'true' And Exists('$(SolutionDir)Library/Prefabric/MSBuild/Prefabric.Generated.props')" />

  <!-- Unity.EntryPoint.Sdk imports package props before setting IsEntryPointProject. -->
  <PropertyGroup Condition="'$(_PrefabricImportBuildProps)' == 'true' And '$(PrefabricActive)' == 'true' And '$(DesignTimeBuild)' == 'true' And '$(IsEntryPointProject)' != 'true' And '$(MSBuildProjectName)' != 'Main.EntryPoint'">
    <NoWarn>$(NoWarn);USG0001</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(_PrefabricImportBuildProps)' == 'true' And Exists('$(SolutionDir)Library/Prefabric/MSBuild/Prefabric.Generated.props')">
    <_PrefabricGeneratedProps Include="$(SolutionDir)Library/Prefabric/MSBuild/Prefabric.Generated.props" />
    <FastUpToDateCheckBuildInput Include="_PrefabricGeneratedProps" />
  </ItemGroup>

  <ItemGroup Condition="'$(_PrefabricImportBuildProps)' == 'true' And '$(PrefabricActive)' == 'true' And '$(IsEntryPointProject)' != 'true' And '$(MSBuildProjectName)' != 'Main.EntryPoint'">
    <ProjectCapability Include="Unity" />
    <ProjectCapability Include="EnableOnDemandExcludedFolderLoading" />
  </ItemGroup>
</Project>
